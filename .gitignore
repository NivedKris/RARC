# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---------- secrets (API keys live only in .env / .env.local) ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- dependencies ----------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Next.js / build output ----------
/.next/
/out/
/build
/coverage
*.tsbuildinfo
next-env.d.ts

# ---------- deployment ----------
.vercel

# ---------- evaluation scratch ----------
# canary files created and deleted by the sandbox attack suite
/eval/canary-*/
# note: eval/out/*.json, eval/log-*.txt, data/*.json and public/*.json are committed on purpose:
# they are the logged runs, replay recordings and LLM cache that the demo and scripts/analyze.ts need.

# ---------- logs ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
